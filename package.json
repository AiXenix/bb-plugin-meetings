{
  "name": "bb-plugin-meetings",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "Meetings",
    "description": "A notetaker bot joins Zoom meetings from a link, records them and transcribes them locally with GigaAM v3, split by speaker.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "ical.js": "^2.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^30.1.2",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^5.0.4"
  },
  "description": "Fireflies-style meeting notetaker for bb: a bot joins Zoom meetings from a link, records them, and transcribes them locally with GigaAM v3, split by speaker.",
  "license": "MIT",
  "author": "AiXenix (https://aixenix.com)",
  "homepage": "https://github.com/AiXenix/bb-plugin-meetings#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AiXenix/bb-plugin-meetings.git"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "zoom",
    "meeting-recorder",
    "notetaker",
    "transcription",
    "diarization",
    "gigaam",
    "russian",
    "google-calendar",
    "oauth",
    "avatar"
  ],
  "scripts": {
    "embed": "node scripts/embed-runtime.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:bot": "node --test \"runtime/bot/lib/*.test.mjs\"",
    "test:py": ".e2e/venv/bin/python -I runtime/transcriber/test_transcriber.py",
    "e2e:bot": "node scripts/e2e-bot-mock.mjs all",
    "e2e:server": "MEETINGS_E2E=1 vitest run test/server-e2e.test.ts",
    "build": "bb plugin build"
  },
  "bugs": {
    "url": "https://github.com/AiXenix/bb-plugin-meetings/issues"
  }
}
